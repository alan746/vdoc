    "tableHeader",
    "paragraphBorderGroups",
    "paragraphLayout",
    "stableIds",
    "referenceSync",
    "placeholder"
  ],
  "nodes": [
    {
      "name": "paragraph",
      "spec": {
        "content": "inline*",
        "group": "block",
        "attrs": {
          "textAlign": {
            "default": null
          },
          "keepWithNext": {
            "default": null
          },
          "keepLinesTogether": {
            "default": false
          },
          "preventSingleLines": {
            "default": true
          },
          "paragraphBorderJoin": {
            "default": false
          },
          "paragraphBorders": {
            "default": null
          },
          "paragraphBackground": {
            "default": null
          },
          "indent": {
            "default": 0
          },
          "indentStart": {
            "default": null
          },
          "indentEnd": {
            "default": 0
          },
          "firstLineIndent": {
            "default": 0
          },
          "tabInterval": {
            "default": 48
          },
          "direction": {
            "default": "auto"
          },
          "spaceBefore": {
            "default": null
          },
          "spaceAfter": {
            "default": null
          },
          "lineHeight": {
            "default": null
          },
          "blockId": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "p",
            "preserveWhitespace": "full"
          },
          {
            "tag": "p"
          }
        ]
      }
    },
    {
      "name": "doc",
      "spec": {
        "content": "block+",
        "attrs": {
          "language": {
            "default": "und"
          },
          "pageSize": {
            "default": "a4"
          },
          "orientation": {
            "default": "portrait"
          },
          "pageMargin": {
            "default": 20
          },
          "pageColor": {
            "default": "#FFFFFF"
          },
          "header": {
            "default": ""
          },
          "footer": {
            "default": ""
          },
          "pageNumbers": {
            "default": false
          }
        }
      }
    },
    {
      "name": "blockquote",
      "spec": {
        "content": "block+",
        "group": "block",
        "defining": true,
        "attrs": {
          "blockId": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "blockquote"
          }
        ]
      }
    },
    {
      "name": "codeBlock",
      "spec": {
        "content": "text*",
        "marks": "",
        "group": "block",
        "code": true,
        "defining": true,
        "attrs": {
          "language": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "pre",
            "preserveWhitespace": "full"
          }
        ]
      }
    },
    {
      "name": "hardBreak",
      "spec": {
        "group": "inline",
        "inline": true,
        "selectable": false,
        "linebreakReplacement": true,
        "parseDOM": [
          {
            "tag": "br"
          }
        ]
      }
    },
    {
      "name": "horizontalRule",
      "spec": {
        "group": "block",
        "parseDOM": [
          {
            "tag": "hr"
          }
        ]
      }
    },
    {
      "name": "text",
      "spec": {
        "group": "inline"
      }
    },
    {
      "name": "heading",
      "spec": {
        "content": "inline*",
        "group": "block",
        "defining": true,
        "attrs": {
          "textAlign": {
            "default": null
          },
          "keepWithNext": {
            "default": null
          },
          "keepLinesTogether": {
            "default": false
          },
          "preventSingleLines": {
            "default": true
          },
          "paragraphBorderJoin": {
            "default": false
          },
          "paragraphBorders": {
            "default": null
          },
          "paragraphBackground": {
            "default": null
          },
          "indent": {
            "default": 0
          },
          "indentStart": {
            "default": null
          },
          "indentEnd": {
            "default": 0
          },
          "firstLineIndent": {
            "default": 0
          },
          "tabInterval": {
            "default": 48
          },
          "direction": {
            "default": "auto"
          },
          "spaceBefore": {
            "default": null
          },
          "spaceAfter": {
            "default": null
          },
          "lineHeight": {
            "default": null
          },
          "blockId": {
            "default": null
          },
          "level": {
            "default": 1
          }
        },
        "parseDOM": [
          {
            "tag": "h1",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h2",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h3",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h4",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h5",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h6",
            "preserveWhitespace": "full"
          },
          {
            "tag": "h1",
            "attrs": {
              "level": 1
            }
          },
          {
            "tag": "h2",
            "attrs": {
              "level": 2
            }
          },
          {
            "tag": "h3",
            "attrs": {
              "level": 3
            }
          },
          {
            "tag": "h4",
            "attrs": {
              "level": 4
            }
          },
          {
            "tag": "h5",
            "attrs": {
              "level": 5
            }
          },
          {
            "tag": "h6",
            "attrs": {
              "level": 6
            }
          }
        ]
      }
    },
    {
      "name": "orderedList",
      "spec": {
        "content": "listItem+",
        "group": "block list",
        "attrs": {
          "blockId": {
            "default": null
          },
          "start": {
            "default": 1
          },
          "type": {
            "default": null
          },
          "numberPrefix": {
            "default": ""
          },
          "numberSuffix": {
            "default": "."
          },
          "continuePrevious": {
            "default": false
          }
        },
        "parseDOM": [
          {
            "tag": "ol"
          }
        ]
      }
    },
    {
      "name": "bulletList",
      "spec": {
        "content": "listItem+",
        "group": "block list",
        "attrs": {
          "blockId": {
            "default": null
          },
          "bulletText": {
            "default": null
          },
          "bulletStyle": {
            "default": "disc"
          }
        },
        "parseDOM": [
          {
            "tag": "ul"
          }
        ]
      }
    },
    {
      "name": "listItem",
      "spec": {
        "content": "(paragraph | heading) block*",
        "defining": true,
        "parseDOM": [
          {
            "tag": "li"
          }
        ]
      }
    },
    {
      "name": "table",
      "spec": {
        "tableRole": "table",
        "content": "tableRow+",
        "group": "block",
        "isolating": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "columnDirection": {
            "default": "ltr"
          },
          "alignment": {
            "default": "left"
          },
          "pinnedRows": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "table"
          }
        ]
      }
    },
    {
      "name": "tableRow",
      "spec": {
        "tableRole": "row",
        "content": "(tableCell | tableHeader)*",
        "attrs": {
          "blockId": {
            "default": null
          },
          "minHeight": {
            "default": null
          },
          "allowSplit": {
            "default": false
          }
        },
        "parseDOM": [
          {
            "tag": "tr"
          }
        ]
      }
    },
    {
      "name": "taskList",
      "spec": {
        "content": "taskItem+",
        "group": "block list",
        "attrs": {
          "blockId": {
            "default": null
          },
          "strikeCompleted": {
            "default": true
          }
        },
        "parseDOM": [
          {
            "tag": "ul[data-type=\"taskList\"]",
            "priority": 51
          }
        ]
      }
    },
    {
      "name": "taskItem",
      "spec": {
        "content": "(paragraph | heading) block*",
        "defining": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "checked": {
            "default": false
          }
        },
        "parseDOM": [
          {
            "tag": "li[data-type=\"taskItem\"]",
            "priority": 51
          }
        ]
      }
    },
    {
      "name": "image",
      "spec": {
        "group": "block",
        "inline": false,
        "draggable": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "src": {
            "default": null
          },
          "alt": {
            "default": null
          },
          "title": {
            "default": null
          },
          "width": {
            "default": 320
          },
          "height": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "img[src]"
          }
        ]
      }
    },
    {
      "name": "pageBreak",
      "spec": {
        "group": "block",
        "atom": true,
        "selectable": true,
        "attrs": {
          "blockId": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "div[data-page-break]"
          }
        ]
      }
    },
    {
      "name": "footnote",
      "spec": {
        "group": "inline",
        "inline": true,
        "atom": true,
        "attrs": {
          "text": {
            "default": ""
          },
          "number": {
            "default": 1
          }
        },
        "parseDOM": [
          {
            "tag": "sup[data-note]",
            "priority": 100
          }
        ]
      }
    },
    {
      "name": "tableOfContents",
      "spec": {
        "group": "block",
        "atom": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "items": {
            "default": []
          }
        },
        "parseDOM": [
          {
            "tag": "nav[data-table-of-contents]"
          }
        ]
      }
    },
    {
      "name": "tableCell",
      "spec": {
        "tableRole": "cell",
        "content": "block+",
        "isolating": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "colspan": {
            "default": 1
          },
          "rowspan": {
            "default": 1
          },
          "colwidth": {
            "default": null
          },
          "align": {
            "default": null
          },
          "backgroundColor": {
            "default": null
          },
          "minHeight": {
            "default": null
          },
          "borderColor": {
            "default": null
          },
          "borderStyle": {
            "default": "solid"
          },
          "borderWidth": {
            "default": null
          },
          "padding": {
            "default": null
          },
          "borders": {
            "default": null
          },
          "verticalAlign": {
            "default": "top"
          }
        },
        "parseDOM": [
          {
            "tag": "td"
          },
          {
            "tag": "td"
          }
        ]
      }
    },
    {
      "name": "tableHeader",
      "spec": {
        "tableRole": "header_cell",
        "content": "block+",
        "isolating": true,
        "attrs": {
          "blockId": {
            "default": null
          },
          "colspan": {
            "default": 1
          },
          "rowspan": {
            "default": 1
          },
          "colwidth": {
            "default": null
          },
          "align": {
            "default": null
          },
          "backgroundColor": {
            "default": null
          },
          "minHeight": {
            "default": null
          },
          "borderColor": {
            "default": null
          },
          "borderStyle": {
            "default": "solid"
          },
          "borderWidth": {
            "default": null
          },
          "padding": {
            "default": null
          },
          "borders": {
            "default": null
          },
          "verticalAlign": {
            "default": "top"
          }
        },
        "parseDOM": [
          {
            "tag": "th"
          },
          {
            "tag": "th"
          }
        ]
