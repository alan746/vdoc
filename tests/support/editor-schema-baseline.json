{
  "extensions": [
    "nativeSelectionSync",
    "searchHighlights",
    "formatOverride",
    "bold",
    "underline",
    "doc",
    "blockquote",
    "code",
    "codeBlock",
    "dropCursor",
    "gapCursor",
    "hardBreak",
    "undoRedo",
    "horizontalRule",
    "italic",
    "listKeymap",
    "link",
    "strike",
    "text",
    "trailingNode",
    "paragraph",
    "heading",
    "orderedList",
    "bulletList",
    "listItem",
    "listItemBranchingDeleteKeymap",
    "vdocListEditing",
    "vdocListConversion",
    "textStyleKit",
    "color",
    "fontFamily",
    "fontSize",
    "textStyle",
    "textAlign",
    "highlight",
    "superscript",
    "subscript",
    "tableKit",
    "table",
    "tableRow",
    "taskList",
    "taskItem",
    "taskItemBranchingDeleteKeymap",
