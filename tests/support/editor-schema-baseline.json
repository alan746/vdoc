  ],
  "marks": [
    {
      "name": "formatOverride",
      "spec": {
        "attrs": {
          "boldOff": {
            "default": false
          },
          "underlineOff": {
            "default": false
          }
        },
        "parseDOM": [
          {
            "tag": "span[data-vdoc-format-override]"
          }
        ]
      }
    },
    {
      "name": "link",
      "spec": {
        "inclusive": true,
        "attrs": {
          "href": {
            "default": null
          },
          "target": {
            "default": "_blank"
          },
          "rel": {
            "default": "noopener noreferrer nofollow"
          },
          "class": {
            "default": null
          },
          "title": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "a[href]"
          }
        ]
      }
    },
    {
      "name": "textStyle",
      "spec": {
        "attrs": {
          "color": {
            "default": null
          },
          "fontFamily": {
            "default": null
          },
          "fontSize": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "span",
            "consuming": false
          }
        ]
      }
    },
    {
      "name": "bold",
      "spec": {
        "parseDOM": [
          {
            "tag": "strong"
          },
          {
            "tag": "b"
          },
          {
            "style": "font-weight=400"
          },
          {
            "style": "font-weight"
          }
        ]
      }
    },
    {
      "name": "underline",
      "spec": {
        "parseDOM": [
          {
            "tag": "u"
          },
          {
            "style": "text-decoration",
            "consuming": false
          }
        ]
      }
    },
    {
      "name": "code",
      "spec": {
        "excludes": "_",
        "code": true,
        "parseDOM": [
          {
            "tag": "code"
          }
        ]
      }
    },
    {
      "name": "italic",
      "spec": {
        "parseDOM": [
          {
            "tag": "em"
          },
          {
            "tag": "i"
          },
          {
            "style": "font-style=normal"
          },
          {
            "style": "font-style=italic"
          }
        ]
      }
    },
    {
      "name": "strike",
      "spec": {
        "parseDOM": [
          {
            "tag": "s"
          },
          {
            "tag": "del"
          },
          {
            "tag": "strike"
          },
          {
            "style": "text-decoration",
            "consuming": false
          }
        ]
      }
    },
    {
      "name": "highlight",
      "spec": {
        "attrs": {
          "color": {
            "default": null
          }
        },
        "parseDOM": [
          {
            "tag": "mark"
          }
        ]
      }
    },
    {
      "name": "superscript",
      "spec": {
        "parseDOM": [
          {
            "tag": "sup"
          },
          {
            "style": "vertical-align"
          }
        ]
      }
    },
    {
      "name": "subscript",
      "spec": {
        "parseDOM": [
          {
            "tag": "sub"
          },
          {
            "style": "vertical-align"
          }
        ]
      }
    }
