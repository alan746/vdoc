import { setEffectiveFormat, effectiveFormatActive } from './format-overrides';
import { patchParagraphBorders } from './paragraph-borders';
import { listSelectionBoundaryError } from './list-conversion';
import { applyTextFormat } from './format-copy';
import { changeChecklistStyle } from './checklist';
import { selectedListItemType } from './list-editing';
import { liftCellLists } from './cell-lists';
import { changeListStyle, changeListMarker } from './list-style';
import { changeListNumbering } from './list-numbering';
import { selectedParagraphs } from './paragraph-selection';
import { reorderedTable } from './table-move';
import { tableBorderChanges } from './table-borders';
import { completePinnedBoundary, pinnedRowCount } from './table-headers';
import { canonicalLanguage } from './language';
import { isTextBoundary } from './unicode';
import { subdivideCell } from './table-split';
import { findMatches } from './search';
import { paragraphIndent, stepParagraphIndent } from './paragraph-indent';
import { adjustRulerIndent } from './paragraph-ruler';
import type { Editor, CommandProps } from '@tiptap/core';
import { TextSelection, NodeSelection, type SelectionBookmark } from '@tiptap/pm/state';
import { CellSelection, TableMap, selectedRect } from '@tiptap/pm/tables';
import { Mark } from '@tiptap/pm/model';
import { closeHistory, undoDepth, redoDepth } from '@tiptap/pm/history';
import { externalRequestSchema, requestSchema, operationLabel, type Operation, type OperationRecord, type OperationResult } from './operations';

function applyOperation(op: Operation, props: CommandProps): boolean {
  const { state } = props;
  void state.tr;
  // Tiptap's chainable state refreshes its cached doc/selection when `tr` is read.
  // Refresh before every command, including several commands within one operation.
  const c = new Proxy(props.commands, {
    get(target, key: keyof CommandProps['commands']) {
      const command = target[key];
      return (...args: unknown[]) => { void state.tr; return Reflect.apply(command, target, args); };
    },
  });
  switch (op.type) {
    case 'format.apply': return applyTextFormat(state.tr,op.format);
    case 'text.style': {
      const s = op.style;
      for (const mark of ['bold', 'italic', 'underline', 'strike'] as const) {
        if (s[mark] !== undefined) {
          if (mark === 'bold' || mark === 'underline') { if (!setEffectiveFormat(state.tr, mark, s[mark]!)) return false; }
          else if (!(s[mark] ? c.setMark(mark) : c.unsetMark(mark))) return false;
        }
      }
      if (s.color !== undefined && !(s.color ? c.setColor(s.color) : c.unsetColor())) return false;
      if (s.highlight !== undefined && !(s.highlight ? c.setHighlight({ color: s.highlight }) : c.unsetHighlight())) return false;
      if (s.fontFamily && !c.setFontFamily(s.fontFamily)) return false;
      if (s.fontSize && !c.setFontSize(`${s.fontSize}px`)) return false;
      if (s.script) {
        c.unsetSuperscript(); c.unsetSubscript();
        if (s.script !== 'normal' && !c.setMark(s.script)) return false;
      }
      return true;
    }
    case 'text.toggle': {
      if (op.mark === 'bold' || op.mark === 'underline') return setEffectiveFormat(state.tr, op.mark, !effectiveFormatActive(state, op.mark));
      if (op.mark === 'superscript') c.unsetSubscript();
      if (op.mark === 'subscript') c.unsetSuperscript();
      return c.toggleMark(op.mark);
    }
    case 'text.insert':
      // Plain text only: never interpret caller-supplied strings as HTML.
      return c.insertContent(op.text.split('\n').flatMap((text, i) => [
        ...(i ? [{ type: 'hardBreak' }] : []), ...(text ? [{ type: 'text', text }] : []),
      ]));
    case 'text.clear': return c.unsetAllMarks();
    case 'text.delete': return !state.selection.empty && c.deleteSelection();
    case 'text.replace': {
      const { from, to } = state.selection;
      state.tr.insertText(op.text, from, to);
      return true;
    }
    case 'block.move': {
      let source: { pos: number; node: import('@tiptap/pm/model').Node } | undefined;
      let destination = op.beforeId === null ? state.doc.content.size : -1;
      state.doc.forEach((node, pos) => {
        if (node.attrs.blockId === op.id) source = { pos, node };
        if (node.attrs.blockId === op.beforeId) destination = pos;
      });
      if (!source || destination < 0 || op.id === op.beforeId) return false;
      const { pos, node } = source;
      const tr = state.tr;
      tr.delete(pos, pos + node.nodeSize);
      tr.insert(destination > pos ? destination - node.nodeSize : destination, node);
      return true;
    }
    case 'table.border': {
      const rect = selectedRect(state);
      const changes = tableBorderChanges(rect.table, rect, op.scope, {color:op.color,width:op.width,style:op.style});
      if (!changes || !changes.size) return false;
      for (const [offset,borders] of changes) state.tr.setNodeMarkup(rect.tableStart + offset, undefined, {...rect.table.nodeAt(offset)!.attrs,borders});
      return true;
    }
    case 'table.pinRows': {
      const { table, tableStart } = selectedRect(state);
      if (op.count > table.childCount || completePinnedBoundary(table, op.count) !== op.count) return false;
      state.tr.setMeta('vdocPinnedRows', [...(state.tr.getMeta('vdocPinnedRows') || []), table.attrs.blockId]);
      state.tr.setNodeMarkup(tableStart - 1, undefined, { ...table.attrs, pinnedRows: op.count });
      return true;
    }
    case 'table.direction': {
      const { table, tableStart } = selectedRect(state);
      state.tr.setNodeMarkup(tableStart - 1, undefined, { ...table.attrs, columnDirection: op.direction });
      return true;
    }
    case 'table.rowBreak': {
      const { table, tableStart } = selectedRect(state);
      if (op.from >= op.to || op.to > table.childCount) return false;
      table.forEach((row, offset, index) => {
        if (index >= op.from && index < op.to) state.tr.setNodeMarkup(tableStart + offset, undefined, { ...row.attrs, allowSplit: op.allowSplit });
      });
      return true;
    }
    case 'table.layout': {
      const { table, tableStart } = selectedRect(state);
      state.tr.setNodeMarkup(tableStart - 1, undefined, { ...table.attrs, alignment: op.alignment });
      return true;
    }
    case 'table.rowHeight': {
      const { table, tableStart, map } = selectedRect(state);
      if (op.row >= map.height) return false;
      table.forEach((row, offset, index) => {
        if (index === op.row) state.tr.setNodeMarkup(tableStart + offset, undefined, { ...row.attrs, minHeight: op.height });
      });
      // A rowspan's content/minimum belongs to several rows; retain it. Only
      // remove legacy cell-height constraints confined to the resized row.
      for (const offset of new Set(map.map.slice(op.row * map.width, (op.row + 1) * map.width))) {
        const cell = table.nodeAt(offset)!;
        if (cell.attrs.rowspan === 1 && cell.attrs.minHeight !== null)
          state.tr.setNodeMarkup(tableStart + offset, undefined, { ...cell.attrs, minHeight: null });
      }
      return true;
    }
    case 'table.columnWidth': {
      const { table, tableStart, map } = selectedRect(state);
      if (op.column >= map.width) return false;
      for (const offset of new Set(map.map.filter((_, index) => index % map.width === op.column))) {
        const cell = table.nodeAt(offset)!;
        const widths = cell.attrs.colwidth ? [...cell.attrs.colwidth] : Array(cell.attrs.colspan).fill(0);
        widths[op.column - map.colCount(offset)] = op.width;
        state.tr.setNodeMarkup(tableStart + offset, undefined, { ...cell.attrs, colwidth: widths });
      }
      return true;
    }
    case 'table.distributeRows': {
      const { table, tableStart, map } = selectedRect(state);
      if (op.from >= op.to || op.to > map.height) return false;
      // A spanning cell crossing the boundary cannot be resized without touching
      // an unselected row. Reject the whole transaction instead of changing it.
      const cells = [...new Set(map.map.slice(op.from * map.width, op.to * map.width))];
      for (const offset of cells) {
        const bounds = map.findCell(offset);
        if (bounds.top < op.from || bounds.bottom > op.to) return false;
      }
      table.forEach((row, offset, index) => {
        if (index >= op.from && index < op.to) state.tr.setNodeMarkup(tableStart + offset, undefined, { ...row.attrs, minHeight: op.height });
      });
      for (const offset of cells) {
        const cell = table.nodeAt(offset)!;
        state.tr.setNodeMarkup(tableStart + offset, undefined, { ...cell.attrs, minHeight: null });
      }
      return true;
    }
    case 'table.style': {
      const { type, ...attrs } = op;
      if (!Object.keys(attrs).length) return false;
      const rect = selectedRect(state);
      const borderPatch = { ...(op.borderColor !== undefined ? {color:op.borderColor} : {}), ...(op.borderWidth !== undefined ? {width:op.borderWidth} : {}), ...(op.borderStyle !== undefined ? {style:op.borderStyle} : {}) };
      if (Object.keys(borderPatch).length) {
        const changes = tableBorderChanges(rect.table,rect,'all',borderPatch);
        if (!changes) return false;
        for (const [offset,borders] of changes) state.tr.setNodeMarkup(rect.tableStart + offset,undefined,{...rect.table.nodeAt(offset)!.attrs,borders});
      }
      if (op.minHeight !== undefined) rect.table.forEach((row, offset, index) => {
        if (index >= rect.top && index < rect.bottom) state.tr.setNodeMarkup(rect.tableStart + offset, undefined, { ...row.attrs, minHeight: null });
      });
      for (const offset of rect.map.cellsInRect(rect)) {
        const cell = state.tr.doc.nodeAt(rect.tableStart + offset)!;
        state.tr.setNodeMarkup(rect.tableStart + offset, undefined, { ...cell.attrs, ...attrs });
      }
      return true;
    }
    case 'table.split': return subdivideCell(state, op.rows, op.cols);
    case 'table.widths': {
      const $from = state.selection.$from;
      let depth = $from.depth;
      while (depth > 0 && $from.node(depth).type.name !== 'table') depth--;
      if (!depth) return false;
      const table = $from.node(depth), map = TableMap.get(table), start = $from.start(depth);
      if (op.widths.length !== map.width) return false;
      const tr = state.tr;
      for (const offset of new Set(map.map)) {
        const cell = table.nodeAt(offset)!;
        const column = map.colCount(offset);
        tr.setNodeMarkup(start + offset, undefined, { ...cell.attrs, colwidth: op.widths.slice(column, column + cell.attrs.colspan) });
      }
      return true;
    }
    case 'paragraph.border': {
      const tr=state.tr, paragraphs=selectedParagraphs(tr.doc,tr.selection);
      if(!paragraphs.length) return false;
      for(const {node,pos} of paragraphs) {
        const paragraphBorders=patchParagraphBorders(node.attrs.paragraphBorders,op);
        const paragraphBorderJoin=op.join ?? node.attrs.paragraphBorderJoin;
        if(JSON.stringify(paragraphBorders)!==JSON.stringify(node.attrs.paragraphBorders)||paragraphBorderJoin!==node.attrs.paragraphBorderJoin) tr.setNodeMarkup(pos,undefined,{...node.attrs,paragraphBorders,paragraphBorderJoin});
      }
      return true;
    }
    case 'paragraph.style': {
      if (op.level !== undefined && !(op.level === 0 ? c.setParagraph() : c.setHeading({ level: op.level as 1 | 2 | 3 | 4 | 5 | 6 }))) return false;
      if (op.align && !c.setTextAlign(op.align)) return false;
      if (op.lineHeight) {
        void state.tr;
        const types = new Set(selectedParagraphs(state.doc, state.selection).map(({ node }) => node.type.name));
        for (const type of types) if (!c.updateAttributes(type, { lineHeight: op.lineHeight })) return false;
      }
      const layout: Record<string, number | string | boolean | null> = {};
      if (op.direction) layout.direction = op.direction;
      if (op.indent !== undefined) layout.indentStart = null;
      for (const key of ['paragraphBackground', 'tabInterval', 'indent', 'indentStart', 'indentEnd', 'firstLineIndent', 'spaceBefore', 'spaceAfter', 'keepWithNext', 'keepLinesTogether', 'preventSingleLines'] as const) if (op[key] !== undefined) layout[key] = op[key]!;
      if (Object.keys(layout).length) {
        void state.tr;
        const tr = state.tr;
        for (const { node, pos } of selectedParagraphs(tr.doc, tr.selection))
          if (Object.entries(layout).some(([key,value]) => node.attrs[key] !== value))
            tr.setNodeMarkup(pos, undefined, { ...node.attrs, ...layout });
      }
      return true;
    }
    case 'paragraph.adjustIndent': {
      const tr = state.tr, paragraphs = selectedParagraphs(tr.doc, tr.selection);
      if (!paragraphs.length) return false;
      for (const { node, pos } of paragraphs) {
        const value = adjustRulerIndent(paragraphIndent(node.attrs), op.handle, op.delta);
        if (Object.values(value).some(n => !Number.isFinite(n) || Math.abs(n) > 10000)) return false;
        const patch = op.handle === 'end' ? { indentEnd: value.indentEnd }
          : op.handle === 'start' ? { indentStart: value.indentStart }
          : { indentStart: value.indentStart, firstLineIndent: value.firstLineIndent };
        if (op.delta) tr.setNodeMarkup(pos, undefined, { ...node.attrs, ...patch });
      }
      return true;
    }
    case 'paragraph.indent': {
      const tr=state.tr;
      for (const { node, pos } of selectedParagraphs(tr.doc, tr.selection)) {
        const current=node.attrs.indentStart ?? (node.attrs.indent || 0)*24;
        const next=stepParagraphIndent(current,op.direction);
        if(next!==current)tr.setNodeMarkup(pos,undefined,{...node.attrs,indentStart:next});
      } return true;
    }
    case 'list.checklistStyle': return changeChecklistStyle(state.tr, op.strikeCompleted);
    case 'list.marker': return changeListMarker(state.tr, op);
    case 'list.style': return changeListStyle(state.tr, op.style);
    case 'list.restart': return changeListNumbering(state.tr, 'restart', op.start);
    case 'list.continue': return changeListNumbering(state.tr, 'continue');
    case 'list.toggle': return op.kind === 'bullet' ? c.toggleBulletList() : op.kind === 'task' ? c.toggleTaskList() : c.toggleOrderedList();
    case 'list.indent': {
      if (state.selection instanceof CellSelection) return op.direction === 'out' && liftCellLists(state.tr);
      const type = selectedListItemType(state.selection);
      return !!type && (op.direction === 'in' ? c.sinkListItem(type) : c.liftListItem(type));
    }
    case 'text.findReplace': {
      const matches = findMatches(state.doc, op.query, op.caseSensitive, op.wholeWord);
      if (!matches.length) return false;
      for (const { from, to } of matches.reverse()) state.tr.insertText(op.replacement, from, to);
      return true;
    }
    case 'document.language': state.tr.setDocAttribute('language', canonicalLanguage(op.language)); return true;
    case 'document.layout': { const { type, ...attrs } = op; for (const [key, value] of Object.entries(attrs)) state.tr.setDocAttribute(key, value); return true; }
    case 'image.insert': return c.setImage({ src: op.src, alt: op.alt, width: op.width });
    case 'image.update': {
      if (!(state.selection instanceof NodeSelection) || state.selection.node.type.name !== 'image') return false;
      const { type, ...attrs } = op, previous = state.selection.node.attrs;
      const height = attrs.width && previous.width > 0 && previous.height > 0 ? attrs.width * previous.height / previous.width : null;
      if (height !== null && (!Number.isFinite(height) || height > 10000)) return false;
      return c.updateAttributes('image', { ...attrs, ...(attrs.width ? { height } : {}) });
    }
    case 'block.code': return c.toggleCodeBlock();
    case 'footnote.update': return state.selection instanceof NodeSelection && state.selection.node.type.name === 'footnote' && c.updateAttributes('footnote', { text: op.text });
    case 'footnote.insert': {
      let number = 1; state.doc.descendants(node => { if (node.type.name === 'footnote') number = Math.max(number, node.attrs.number + 1); });
      return c.insertContent({ type: 'footnote', attrs: { text: op.text, number } });
    }
    case 'block.toc': return c.insertContent({ type: 'tableOfContents' });
    case 'block.pageBreak': return c.insertContent({ type: 'pageBreak' });
    case 'table.move': {
      const rect = selectedRect(state);
      const moved = reorderedTable(rect.table, op.axis, op.from, op.to);
      if (!moved) return false;
      state.tr.replaceWith(rect.tableStart - 1, rect.tableStart - 1 + rect.table.nodeSize, moved);
      const map = TableMap.get(moved);
      const row = op.axis === 'row' ? op.to : Math.min(rect.top, map.height - 1);
      const col = op.axis === 'column' ? op.to : Math.min(rect.left, map.width - 1);
      state.tr.setSelection(CellSelection.create(state.tr.doc, rect.tableStart + map.map[row * map.width + col]));
      return true;
    }
    case 'table.sort': {
      const rect = selectedRect(state);
      if (op.column >= rect.map.width) return false;
      const rows = Array.from({ length: rect.table.childCount }, (_, i) => rect.table.child(i));
      const pinned = rows.splice(0, pinnedRowCount(rect.table));
      if (rows.some(row => Array.from({ length: row.childCount }, (_, i) => row.child(i)).some(cell => cell.attrs.colspan !== 1 || cell.attrs.rowspan !== 1))) return false;
      const language = state.doc.attrs.language;
      rows.sort((a, b) => a.child(op.column).textContent.localeCompare(b.child(op.column).textContent, language && language !== 'und' ? language : undefined, { numeric: true }) * (op.descending ? -1 : 1));
      state.tr.replaceWith(rect.tableStart - 1, rect.tableStart - 1 + rect.table.nodeSize, rect.table.type.create(rect.table.attrs, [...pinned, ...rows]));
      return true;
    }
    case 'block.quote': return c.toggleBlockquote();
    case 'block.rule': return c.setHorizontalRule();
    case 'table.insert': return c.insertTable({ rows: op.rows, cols: op.cols, withHeaderRow: op.header });
    case 'table.edit': {
      if (op.action === 'merge') {
        const rect = selectedRect(state), pinned = pinnedRowCount(rect.table);
        if (rect.table.attrs.pinnedRows != null && rect.top < pinned && rect.bottom > pinned) return false;
      }
      if (op.action === 'deleteRow' || op.action === 'deleteColumn') {
        let depth = state.selection.$from.depth;
        while (depth > 0 && state.selection.$from.node(depth).type.name !== 'table') depth--;
        if (depth) {
          const rect = selectedRect(state);
          if ((op.action === 'deleteRow' && rect.top === 0 && rect.bottom === rect.map.height) || (op.action === 'deleteColumn' && rect.left === 0 && rect.right === rect.map.width)) return c.deleteTable();
        }
      }
      const actions = {
        rowBefore: c.addRowBefore, rowAfter: c.addRowAfter, columnBefore: c.addColumnBefore, columnAfter: c.addColumnAfter,
        deleteRow: c.deleteRow, deleteColumn: c.deleteColumn, deleteTable: c.deleteTable, merge: c.mergeCells,
        split: c.splitCell, headerRow: c.toggleHeaderRow,
      };
      return actions[op.action]();
    }
    case 'table.background': {
      const rect = selectedRect(state);
      for (const offset of rect.map.cellsInRect(rect)) {
        const cell = state.tr.doc.nodeAt(rect.tableStart + offset)!;
        state.tr.setNodeMarkup(rect.tableStart + offset, undefined, { ...cell.attrs, backgroundColor: op.color });
      }
      return true;
    }
    case 'link.set': return c.setLink({ href: op.href });
    case 'link.unset': return c.unsetLink();
  }
}

/** Single synchronous writer for programmatic edits. Native typing remains in ProseMirror. */
export class DocumentEngine {
  readonly sessionId = crypto.randomUUID();
  private disposed = false;
  revision = 0;
  records: OperationRecord[] = [];
  private bookmark: SelectionBookmark | null = null;
  private results = new Map<string, { signature: string; result: OperationResult }>();
  private listeners = new Set<() => void>();
  private clearBookmarkOnInput = () => { this.bookmark = null; };
  private handleTransaction: (event: { transaction: import('@tiptap/pm/state').Transaction }) => void;

  constructor(readonly editor: Editor) {
    this.handleTransaction = ({ transaction }) => {
      if (transaction.docChanged) this.revision++;
      if (this.bookmark) this.bookmark = this.bookmark.map(transaction.mapping);
      for (const listener of this.listeners) listener();
    };
    editor.on('transaction', this.handleTransaction);
    editor.view.dom.addEventListener('pointerdown', this.clearBookmarkOnInput);
    editor.view.dom.addEventListener('keydown', this.clearBookmarkOnInput);
  }
  subscribe(listener: () => void) { this.listeners.add(listener); return () => { this.listeners.delete(listener); }; }
  destroy() {
    this.disposed = true;
    this.editor.off('transaction', this.handleTransaction);
    this.editor.view.dom.removeEventListener('pointerdown', this.clearBookmarkOnInput);
    this.editor.view.dom.removeEventListener('keydown', this.clearBookmarkOnInput);
    this.listeners.clear();
  }
  captureSelection() { this.bookmark = this.editor.state.selection.getBookmark(); }
  clearSelectionBookmark() { this.bookmark = null; }
  get canUndo() { return undoDepth(this.editor.state) > 0; }
  get canRedo() { return redoDepth(this.editor.state) > 0; }

  executeExternal(input: unknown): OperationResult {
    const parsed = externalRequestSchema.safeParse(input);
    if (!parsed.success) return { ok: false, id: crypto.randomUUID(), revision: this.revision, code: 'INVALID', error: parsed.error.issues[0]?.message || 'Read the document and supply session, revision, and an explicit target.' };
    return this.execute(parsed.data);
  }

  execute(input: unknown): OperationResult {
    const parsed = requestSchema.safeParse(input);
    const id = parsed.success ? parsed.data.id ?? crypto.randomUUID() : crypto.randomUUID();
    const fail = (code: OperationResult['code'], error: string): OperationResult => ({ ok: false, id, revision: this.revision, code, error });
    if (!parsed.success) return fail('INVALID', parsed.error.issues[0]?.message ?? 'Invalid operation parameters.');
    const request = parsed.data;
    if (this.disposed || this.editor.isDestroyed || !this.editor.isEditable) return fail('UNAVAILABLE', 'The document is not editable.');
    if (request.expectedSessionId !== undefined && request.expectedSessionId !== this.sessionId) return fail('STALE', 'The editing session has changed. Read the document again.');
    const signature = JSON.stringify(request);
    const prior = this.results.get(id);
    if (prior) return prior.signature === signature ? prior.result : fail('DUPLICATE', 'An operation ID cannot be reused for a different request.');
    if (this.editor.isDestroyed || !this.editor.isEditable) return fail('UNAVAILABLE', 'The document is not editable.');
    if (this.editor.view.composing) return fail('COMPOSING', 'Finish the current text composition first.');
    if (request.expectedRevision !== undefined && request.expectedRevision !== this.revision) return fail('STALE', 'The document has changed. Read the target again.');
    if (request.target.kind === 'range' && request.expectedRevision === undefined) return fail('STALE', 'An explicit range requires a document revision.');
    if (request.target.kind === 'range' && (request.target.from > request.target.to || request.target.to > this.editor.state.doc.content.size)) return fail('TARGET', 'Invalid target range.');

    let selection = this.editor.state.selection;
    try {
      if (request.target.kind === 'selection' && request.source === 'toolbar' && this.bookmark) selection = this.bookmark.resolve(this.editor.state.doc);
      if (request.target.kind === 'range') {
        const { from, to } = request.target;
        if (!this.editor.state.doc.resolve(from).parent.inlineContent || !this.editor.state.doc.resolve(to).parent.inlineContent) return fail('TARGET', 'Text ranges must be inside editable content.');
        if (!isTextBoundary(this.editor.state.doc,from) || !isTextBoundary(this.editor.state.doc,to)) return fail('TARGET', 'Text ranges must not split a character or emoji.');
        selection = TextSelection.create(this.editor.state.doc, from, to);
      }
      if (request.target.kind === 'cell') {
        const target = request.target;
        let cellPos: number | undefined;
        this.editor.state.doc.descendants((node, pos) => {
          if (node.type.name !== 'table' || node.attrs.blockId !== target.tableId) return;
          node.forEach((row, rowOffset) => row.forEach((cell, cellOffset) => {
            if (cell.attrs.blockId === target.cellId) cellPos = pos + 2 + rowOffset + cellOffset;
          }));
          return false;
        });
        if (cellPos === undefined) return fail('TARGET', 'The cell no longer exists in this table. Read the document again.');
        selection = CellSelection.create(this.editor.state.doc, cellPos);
      }
      if (request.target.kind === 'cells') {
        const target = request.target;
        let found: { pos: number; node: import('@tiptap/pm/model').Node } | undefined;
        this.editor.state.doc.descendants((node, pos) => { if (node.type.name === 'table' && node.attrs.blockId === target.tableId) found = { pos, node }; });
        if (!found) return fail('TARGET', 'The table no longer exists.');
        const map = TableMap.get(found.node), endRow = target.endRow ?? target.row, endCol = target.endCol ?? target.col;
        if (target.row > endRow || target.col > endCol || endRow >= map.height || endCol >= map.width) return fail('TARGET', 'Invalid table region.');
        const start = found.pos + 1;
        selection = CellSelection.create(this.editor.state.doc, start + map.map[target.row * map.width + target.col], start + map.map[endRow * map.width + endCol]);
      }
      if (request.target.kind === 'block') {
        const targetId = request.target.id;
        let found: { pos: number; size: number; textblock: boolean; atom: boolean } | undefined;
        this.editor.state.doc.descendants((node, pos) => {
          if (node.attrs.blockId === targetId) found = { pos, size: node.nodeSize, textblock: node.isTextblock, atom: node.isAtom };
        });
        if (!found) return fail('TARGET', 'The target no longer exists.');
        if (found.atom) selection = NodeSelection.create(this.editor.state.doc, found.pos);
        else if (found.textblock) selection = TextSelection.create(this.editor.state.doc, found.pos + 1, found.pos + found.size - 1);
        else selection = TextSelection.between(this.editor.state.doc.resolve(found.pos + 1), this.editor.state.doc.resolve(found.pos + found.size - 1));
      }
    } catch { return fail('TARGET', 'The target could not be located. Select it again.'); }

    const beforeRevision = this.revision;
    const beforeMarks = selection.empty
      ? (selection.eq(this.editor.state.selection) ? this.editor.state.storedMarks : null) ?? selection.$from.marks()
      : [];
    let error = '';
    const ok = this.editor.chain().command(props => {
      const { tr } = props;
      closeHistory(tr);
      // Re-setting an unchanged cursor clears the user's active typing marks.
      if (!tr.selection.eq(selection)) tr.setSelection(selection);
      tr.setMeta('vdoc', { id, source: request.source });
      try {
        for (const operation of request.operations) {
          if (!applyOperation(operation, props)) { error = (operation.type === 'list.toggle' ? listSelectionBoundaryError(props.tr.selection) : null) || 'This operation is not available for the current selection.'; break; }
        }
        tr.doc.check();
      } catch { error = 'The operation could not be completed. The document is unchanged.'; }
      if (error) tr.setMeta('preventDispatch', true);
      return !error;
    }).run();
    if (!ok || error) return fail('UNAVAILABLE', error || 'The operation was not completed.');

    // Separate this command from subsequent native typing / commands.
    this.editor.view.dispatch(closeHistory(this.editor.state.tr));
    this.bookmark = null;
    if (request.source !== 'api') this.editor.view.focus();
    const afterSelection = this.editor.state.selection;
    const afterMarks = afterSelection.empty ? this.editor.state.storedMarks ?? afterSelection.$from.marks() : [];
    if (this.revision !== beforeRevision || !Mark.sameSet(beforeMarks, afterMarks))
      this.record(id, request.label ?? request.operations.map(operationLabel).join(' · '), request.source, request.operations.length);
    const result = { ok: true, id, revision: this.revision };
    this.results.set(id, { signature, result });
    if (this.results.size > 200) this.results.delete(this.results.keys().next().value!);
    return result;
  }

  history(action: 'undo' | 'redo', source = 'toolbar'): OperationResult {
    const id = crypto.randomUUID();
    if (this.disposed || this.editor.isDestroyed || !this.editor.isEditable) return { ok: false, id, revision: this.revision, code: 'UNAVAILABLE', error: 'The document is not editable.' };
    if (this.editor.view.composing) return { ok: false, id, revision: this.revision, code: 'COMPOSING', error: 'Finish the current text composition first.' };
    this.bookmark = null;
    const ok = this.editor.commands[action]();
    if (ok) {
      this.editor.view.dispatch(closeHistory(this.editor.state.tr));
      if (source !== 'api') this.editor.view.focus();
      this.record(id, action === 'undo' ? 'Undo' : 'Redo', source, 1);
    }
    return { ok, id, revision: this.revision, ...(ok ? {} : { code: 'UNAVAILABLE' as const, error: 'There is nothing to undo or redo.' }) };
  }

  snapshot() {
    const blocks: { id: string; type: string; text: string; from: number; to: number }[] = [];
    this.editor.state.doc.descendants((node, pos) => {
      if (node.attrs.blockId && (node.isTextblock || node.type.name === 'table' || node.isAtom)) blocks.push({ id: node.attrs.blockId, type: node.type.name, text: node.textContent, from: node.isAtom ? pos : pos + 1, to: node.isAtom ? pos + node.nodeSize : pos + node.nodeSize - 1 });
    });
    const tables: { id: string; rows: number; columns: number; columnDirection: 'ltr' | 'rtl'; pinnedRows: number; rowBreaks: { id: string; row: number; allowSplit: boolean }[]; cells: { id: string; rowId: string; row: number; column: number; rowspan: number; colspan: number; text: string }[] }[] = [];
    this.editor.state.doc.descendants(node => {
      if (node.type.name !== 'table') return;
      const map = TableMap.get(node);
      const cells = [...new Set(map.map)].map(offset => {
        const cell = node.nodeAt(offset)!, bounds = map.findCell(offset);
        return { id: cell.attrs.blockId as string, rowId: node.child(bounds.top).attrs.blockId as string, row: bounds.top, column: bounds.left, rowspan: bounds.bottom - bounds.top, colspan: bounds.right - bounds.left, text: cell.textContent };
      });
      tables.push({ id: node.attrs.blockId, rows: map.height, columns: map.width, columnDirection: node.attrs.columnDirection === 'rtl' ? 'rtl' : 'ltr', pinnedRows: pinnedRowCount(node), rowBreaks: Array.from({ length: node.childCount }, (_, row) => ({ id: node.child(row).attrs.blockId as string, row, allowSplit: node.child(row).attrs.allowSplit === true })), cells });
    });
    return { schemaVersion: 1, sessionId: this.sessionId, tables, revision: this.revision, selection: { from: this.editor.state.selection.from, to: this.editor.state.selection.to }, blocks, document: this.editor.getJSON() };
  }
  private record(id: string, label: string, source: string, count: number) {
    this.records = [{ id, label, source, time: Date.now(), revision: this.revision, count }, ...this.records].slice(0, 60);
    for (const listener of this.listeners) listener();
  }
}
