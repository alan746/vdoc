{
  "name": "vdoc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/start-local.mjs",
    "start:worker": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-subscript": "^3.0.0",
    "@tiptap/extension-superscript": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@vrealtime/client": "^0.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "^9.8.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "pagedjs": "0.4.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
